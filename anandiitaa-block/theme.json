{
  "$schema": "https://schemas.wp.org/trunk/theme.json",
  "version": 3,
  "settings": {
    "appearanceTools": true,
    "layout": {
      "contentSize": "1180px",
      "wideSize": "1400px"
    },
    "color": {
      "defaultPalette": false,
      "palette": [
        { "slug": "maroon",      "color": "#6b0f1a", "name": "Maroon" },
        { "slug": "maroon-dark", "color": "#4a0a12", "name": "Maroon Dark" },
        { "slug": "cream",       "color": "#ece1cb", "name": "Cream" },
        { "slug": "text",        "color": "#333333", "name": "Text" },
        { "slug": "white",       "color": "#ffffff", "name": "White" }
      ],
      "gradients": [
        { "slug": "body-cream", "name": "Body Cream", "gradient": "linear-gradient(90deg, #feebc7 0%, #fcf9f3 100%)" }
      ]
    },
    "typography": {
      "fluid": true,
      "fontFamilies": [
        {
          "slug": "display",
          "name": "Appetite Pro",
          "fontFamily": "'Appetite Pro', Georgia, serif",
          "fontFace": [
            { "fontFamily": "Appetite Pro", "fontWeight": "300", "fontStyle": "normal", "src": ["file:./assets/fonts/appetite-pro/AppetitePro-Light.otf"] },
            { "fontFamily": "Appetite Pro", "fontWeight": "400", "fontStyle": "normal", "src": ["file:./assets/fonts/appetite-pro/AppetitePro-Regular.otf"] },
            { "fontFamily": "Appetite Pro", "fontWeight": "500", "fontStyle": "normal", "src": ["file:./assets/fonts/appetite-pro/AppetitePro-Medium.otf"] },
            { "fontFamily": "Appetite Pro", "fontWeight": "700", "fontStyle": "normal", "src": ["file:./assets/fonts/appetite-pro/AppetitePro-Bold.otf"] },
            { "fontFamily": "Appetite Pro", "fontWeight": "900", "fontStyle": "normal", "src": ["file:./assets/fonts/appetite-pro/AppetitePro-Heavy.otf"] }
          ]
        },
        {
          "slug": "body",
          "name": "DM Sans",
          "fontFamily": "'DM Sans', system-ui, sans-serif",
          "fontFace": [
            { "fontFamily": "DM Sans", "fontWeight": "100 1000", "fontStyle": "normal", "src": ["file:./assets/fonts/dm-sans/DMSans-Variable.ttf"] },
            { "fontFamily": "DM Sans", "fontWeight": "100 1000", "fontStyle": "italic", "src": ["file:./assets/fonts/dm-sans/DMSans-Italic-Variable.ttf"] }
          ]
        },
        {
          "slug": "ui",
          "name": "Montserrat",
          "fontFamily": "'Montserrat', system-ui, sans-serif"
        }
      ]
    }
  },
  "styles": {
    "spacing": {
      "blockGap": "0px"
    },
    "color": {
      "gradient": "linear-gradient(90deg, #feebc7 0%, #fcf9f3 100%)",
      "text": "#333333"
    },
    "typography": {
      "fontFamily": "var(--wp--preset--font-family--body)",
      "fontSize": "18px",
      "fontWeight": "400",
      "lineHeight": "1.6"
    },
    "elements": {
      "heading": {
        "typography": {
          "fontFamily": "var(--wp--preset--font-family--display)",
          "fontWeight": "500"
        },
        "color": { "text": "var(--wp--preset--color--maroon)" }
      },
      "link": {
        "color": { "text": "var(--wp--preset--color--maroon)" }
      }
    }
  },
  "templateParts": [
    { "name": "header", "title": "Header", "area": "header" },
    { "name": "footer", "title": "Footer", "area": "footer" }
  ]
}

/*.png
/*.jpg
/*.jpeg
/*.gif
/*.webp
/Screenshot*.png
/screenshot*.png
**/scratch/*.png
**/tmp/*.png

# Graphify build cache (auto-generated, regenerable)
graphify-out/cache/
**/graphify-out/cache/
graphify-out/.graphify_python
**/graphify-out/.graphify_python

# Env / secrets
.env
.env.local
.env.*.local
*.pem
*.key

# Database dumps & backups
*.sql
*.sql.gz
*.dump
*.bak
*~
*.wpress

# Temp / cache
*.tmp
*.temp
*.cache
.phpunit.result.cache
coverage/

# OS extras (in addition to .DS_Store)
Icon?
.Spotlight-V100
.Trashes
ehthumbs.db
Desktop.ini


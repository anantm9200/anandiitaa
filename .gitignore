# OS Metadata
.DS_Store
**/.DS_Store
Thumbs.db

# Docker
.docker/
docker-compose.override.yml

# WordPress core (we only care about our theme)
wordpress/
wp-config.php

# Local Environment / Logs
*.log
npm-debug.log*

# Theme specific
node_modules/
.sass-cache/

# PDF Designs and high-res sources (keep local, too heavy for git)
my-custom-theme/Anandiitaa/*.pdf
my-custom-theme/assets/design-refs/*.pdf
my-custom-theme/assets/images/source/

# Archives
*.zip

# Claude Code (local skills, agent caches, IDE state)
.claude/skills/
.claude/settings.local.json
.claude/cache/
.claude/logs/
.claude/.session*
CLAUDE.local.md

# Python bytecode (from skill scripts)
__pycache__/
*.pyc
*.pyo

# Editor / IDE
.vscode/
.idea/
*.swp
*.swo

# Stray screenshots / scratch images at repo root
